# ===== Telegram =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=123456789,987654321

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_startup
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@localhost:5432/ai_startup
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ===== Existing LLM cluster =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
USE_SELF_HOSTED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Real AI Agent model catalog =====
# The agent makes real provider requests; it never fabricates model output.
AGENT_OPENAI_MODEL=gpt-5.4
AGENT_ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
AGENT_GEMINI_MODEL=gemini-2.5-flash
AGENT_GROQ_MODEL=llama-3.3-70b-versatile
AGENT_OLLAMA_MODEL=qwen3:8b

# ===== Obsidian =====
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_API_URL=

# ===== Cloudflare =====
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_R2_BUCKET=ai-startup-storage
CLOUDFLARE_D1_DATABASE_ID=

# ===== MCP =====
MCP_SERVER_URL=ws://localhost:8765
MCP_ENABLED=true

# ===== GitHub =====
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_DEFAULT_REPO=ai-startup-projects

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Security =====
JWT_SECRET=change_me_to_random_64_chars_string
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=fernet_key_here

# ===== App =====
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
MAX_PARALLEL_TASKS=5
TASK_TIMEOUT_SECONDS=300
